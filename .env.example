# Docker Compose ayarları. Değiştirmek için bu dosyayı .env adıyla kopyalayın.
# Buradaki değerler yalnız yerel geliştirme/demo içindir; gerçek ortamda mutlaka değiştirin.

DB_PASSWORD=avatar_yerel
DB_ROOT_PASSWORD=avatar_root_yerel
LOG_LEVEL=INFO

# Boş veritabanına yüklenecek örnek kayıtlar: none | base | demo (demo: şartname senaryosu hazır gelir)
SEED_PROFILE=demo

# Bilgisayardaki portlar. API yalnız bu bilgisayara açılır (API_BIND=127.0.0.1); yerel ağdan ve
# telefondan erişim web portu üzerinden olur (nginx /api/ isteklerini API'ye aktarır).
# API_BIND=0.0.0.0 yalnız güvenilir bir ağda ve geçici olarak kullanılmalıdır.
API_PORT=8000
API_BIND=127.0.0.1
WEB_PORT=8080

# E-posta. Varsayılan: docker-compose'daki Mailpit (yerel test kutusu; dışarı e-posta GİTMEZ).
# Gönderilenleri görmek için: http://localhost:8025
# Gerçek sunucu için örnek: SMTP_HOST=smtp.sirketiniz.com SMTP_PORT=587 SMTP_USER=avatar@sirketiniz.com
# SMTP_PASS=<şifre>  (SMTP_USER doluysa STARTTLS + giriş yapılır; 465 portunda doğrudan TLS).
# Şifreyi yalnız .env dosyasına yazın; .env depoya girmez.
# E-postayı tamamen kapatmak için SMTP_HOST= (boş) bırakın: e-postalar giden kutusunda bekler.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AVATAR Synera <avatar@synera.example>

# Rapor e-postası alıcıları: sistemdeki aktif kullanıcıların e-postaları her zaman izinli.
# Başka adreslere göndermek için alan adlarını virgülle yazın (ör. sirketiniz.com,bayi.com.tr).
ALLOWED_EMAIL_DOMAINS=

# E-postalardaki bağlantılar bu adrese gider (web arayüzü). WEB_PORT değişirse bunu da değiştirin.
WEB_BASE_URL=http://localhost:8080

# Mailpit portları (bilgisayarda başka bir uygulama kullanıyorsa değiştirin)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

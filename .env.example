# Docker Compose ayarları. Değiştirmek için bu dosyayı .env adıyla kopyalayın.
# Buradaki değerler yalnız yerel geliştirme/demo içindir; gerçek ortamda mutlaka değiştirin.

DB_PASSWORD=avatar_yerel
DB_ROOT_PASSWORD=avatar_root_yerel
LOG_LEVEL=INFO

# Boş veritabanına yüklenecek örnek kayıtlar: none | base | demo (demo: şartname senaryosu hazır gelir)
SEED_PROFILE=demo

# Bilgisayardaki portlar
API_PORT=8000
WEB_PORT=8080

# E-posta (isteğe bağlı). SMTP_HOST boş bırakılırsa hiçbir e-posta gönderilmez: alarm ve rapor
# e-postaları Yönetim > Giden kutusu'nda "Kuyrukta" görünür (oradan e-posta programıyla da açılabilir).
# Örnek: SMTP_HOST=smtp.sirketiniz.com  SMTP_PORT=587  SMTP_USER=synera@sirketiniz.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
